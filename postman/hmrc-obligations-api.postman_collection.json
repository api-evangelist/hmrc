                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "description": "(Required) Fraud prevention header \u2013 client connection method",
                            "key": "Gov-Client-Connection-Method",
                            "value": "<string>"
                          },
                          {
                            "description": "(Required) Fraud prevention header \u2013 vendor application version",
                            "key": "Gov-Vendor-Version",
                            "value": "<string>"
                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/organisations/vat/:vrn/obligations?from=<date>&to=<date>&status=A",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "organisations",
                            "vat",
                            ":vrn",
                            "obligations"
                          ],
                          "query": [
                            {
                              "description": "(Required) Obligation period start date (YYYY-MM-DD), minimum 2017-01-01",
                              "key": "from",
                              "value": "<date>"
                            },
                            {
                              "description": "(Required) Obligation period end date (must be within 366 days of 'from')",
                              "key": "to",
                              "value": "<date>"
                            },
                            {
                              "key": "status",
                              "value": "A"
                            }
                          ],
                          "variable": [
                            {
                              "id": "91a8765e-8566-4287-bf2c-a84ca60d7c2d",
                              "key": "vrn",
                              "value": "844473081",
                              "description": "(Required) VAT Registration Number (9 digits)"
                            }
                          ]
                        },
                        "description": "Retrieves VAT return filing obligations for the specified VAT Registration Number (VRN). Returns periods for which returns must be filed, due dates, and status (Open, Fulfilled) within the requested date range."
