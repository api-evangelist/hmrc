      "name": "Obligations",
      "description": {
        "content": "VAT return filing obligations",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "12d1d923-c762-45a4-b3eb-acf92190c5bd",
          "name": "Retrieve VAT obligations",
          "request": {
            "name": "Retrieve VAT obligations",
            "description": {
              "content": "Retrieves VAT return filing obligations for the specified VAT Registration Number (VRN). Returns periods for which returns must be filed, due dates, and status (Open, Fulfilled) within the requested date range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "organisations",
                "vat",
                ":vrn",
                "obligations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "(Required) Obligation period start date (YYYY-MM-DD), minimum 2017-01-01"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "(Required) Obligation period end date (must be within 366 days of 'from')"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vrn",
                  "description": "(Required) VAT Registration Number (9 digits)"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Fraud prevention header – client connection method",
                "key": "Gov-Client-Connection-Method",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Fraud prevention header – vendor application version",
                "key": "Gov-Vendor-Version",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
